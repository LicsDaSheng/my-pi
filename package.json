    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
